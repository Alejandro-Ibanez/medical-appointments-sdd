{
  "runtime": "Net100",
  "defaultVariables": null,
  "documentGenerator": {
    "fromDocument": {
      "json": null,
      "url": "../api-spec/openapi.yaml",
      "output": null
    }
  },
  "codeGenerators": {
    "openApiToCSharpClient": {
      "jsonLibrary": "SystemTextJson",
      "generateClientClasses": false,
      "generateClientInterfaces": false,
      "generateDtoTypes": true,
      "generateExceptionClasses": false,
      "generateResponseClasses": false,
      "wrapDtoExceptions": false,
      "classStyle": "Poco",
      "generateDefaultValues": true,
      "generateDataAnnotations": true,
      "generateNullableReferenceTypes": true,
      "namespace": "MedicalAppointments.Application.DTOs",
      "requiredPropertiesMustBeDefined": true,
      "dateType": "System.DateTime",
      "dateTimeType": "System.DateTimeOffset",
      "output": "src/MedicalAppointments.Application/DTOs/Dtos.generated.cs"
    },
    "openApiToCSharpController": {
      "jsonLibrary": "SystemTextJson",
      "controllerStyle": "abstract",
      "controllerTarget": "AspNetCore",
      "className": "Citas",
      "generateDtoTypes": false,
      "includedOperationIds": [
        "crearCita",
        "cancelarCita",
        "buscarCitas",
        "generarReporteExcelCitas",
        "generarReportePdfCitas",
        "obtenerEstadisticasDashboard",
        "obtenerMetricasDashboard",
        "obtenerCitasCalendario"
      ],
      "useCancellationToken": true,
      "generateModelValidationAttributes": false,
      "generateOptionalParameters": true,
      "namespace": "MedicalAppointments.Api.Controllers.Generated",
      "additionalNamespaceUsages": [
        "MedicalAppointments.Application.DTOs"
      ],
      "output": "src/MedicalAppointments.Api/Generated/ControllersBase.generated.cs"
    }
  }
}
